# =====================================================================
# FIMF — Variables d'environnement du frontend (Vite)
# Copier ce fichier en .env.local (non versionné) puis renseigner les valeurs.
# Les variables VITE_* sont intégrées au bundle : n'y mettre QUE des
# valeurs publiques (URL du projet + clé anon/publishable). La clé
# service_role ne doit JAMAIS apparaître ici.
# =====================================================================

# Projet Supabase (Dashboard → Project Settings → API)
# Sans ces deux variables l'application s'arrête au démarrage.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<clé anon / publishable>"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
